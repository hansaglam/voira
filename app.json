{
  "expo": {
    "name": "Voira",
    "slug": "echospeak",
    "version": "1.0.12",
    "orientation": "portrait",
    "scheme": "echospeak",
    "icon": "./assets/brand/voira-app-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/brand/voira-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1334"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ethemsincar.echospeak",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1334",
        "foregroundImage": "./assets/brand/voira-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.ethemsincar.echospeak",
      "versionCode": 13,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "echospeak",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "echospeak"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Voira konuşma pratiği için mikrofonunu kullanır.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ]
  }
}
