# EchoSpeak — public env (Expo)
# Copy to .env and fill in values. Never commit real secrets.
# After changing .env, rebuild native app: npx expo run:android / npx expo run:ios

# Speech analysis backend (production Render URL for Play Store builds)
EXPO_PUBLIC_ANALYSIS_ENDPOINT=https://echospeak-api.onrender.com/api/analyze-speech
EXPO_PUBLIC_ANALYSIS_PROVIDER_MODE=backend
EXPO_PUBLIC_AUDIO_REGISTRY_ENDPOINT=https://echospeak-api.onrender.com/api/audio/registry

# Local dev only — do not use 192.168.x.x or localhost for Play Store builds:
# EXPO_PUBLIC_ANALYSIS_ENDPOINT=http://192.168.x.x:3001/api/analyze-speech
# EXPO_PUBLIC_AUDIO_REGISTRY_ENDPOINT=http://192.168.x.x:3001/api/audio/registry

# RevenueCat (public SDK keys only — not App Store shared secrets)
# Android: goog_... | iOS: appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_PREMIUM_ENTITLEMENT_ID=speakplus

# Supabase Auth (publishable/anon key only — never service role key in mobile)
# URL: https://YOUR_PROJECT.supabase.co
# Key: sb_publishable_... or legacy eyJ... anon key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard (Authentication > URL Configuration):
#   Redirect URLs: echospeak://auth/callback
#
# RevenueCat dashboard:
#   Entitlement: speakplus
#   Offerings: monthly/yearly products linked to Google Play / App Store
#
# Native dev build required (not Expo Go):
#   npx expo run:android
#   npx expo run:ios
