{
  "name": "echospeak-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:transcription": "tsx scripts/testTranscription.ts",
    "generate:catalog": "tsx scripts/generateLessonCatalogSnapshot.ts",
    "audio:migrate-supabase": "tsx src/scripts/migrateLocalAudioToSupabase.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.45.0",
    "typescript": "~5.7.2"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  }
}
