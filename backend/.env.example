# Copy this file to backend/.env and set your server-side keys:
#   cp backend/.env.example backend/.env
#
# Server-side only — never use EXPO_PUBLIC_ for secrets below.

PORT=3001
NODE_ENV=development

OPENAI_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=lesson-audio

ADMIN_SECRET=

# Comma-separated browser origins for admin panel CORS (mobile/native clients may omit Origin)
ALLOWED_ORIGINS=

# Public HTTPS URL of this backend in production (e.g. https://echospeak-api.onrender.com)
BACKEND_PUBLIC_URL=

# Max analyze requests per identity per minute (default: 10)
ANALYZE_RATE_LIMIT_PER_MINUTE=10
# Max analyze requests per IP per minute (defense in depth, default: 30)
ANALYZE_IP_RATE_LIMIT_PER_MINUTE=30
# Per-IP cap for legacy clients without modern identity headers (default: 8)
LEGACY_ANALYZE_RATE_LIMIT_PER_MINUTE=8

# Temporary backward compatibility for mobile clients without Bearer / x-guest-id headers.
# Development: allowed unless ALLOW_LEGACY_ANALYSIS_CLIENTS=false
# Production: disabled unless ALLOW_LEGACY_ANALYSIS_CLIENTS=true
ALLOW_LEGACY_ANALYSIS_CLIENTS=
# Optional ISO sunset — legacy access stops automatically after this timestamp.
# Example: 2026-10-01T00:00:00Z
LEGACY_ANALYSIS_CLIENTS_UNTIL=

# External API timeouts (milliseconds)
OPENAI_WHISPER_TIMEOUT_MS=60000
AZURE_SPEECH_TIMEOUT_MS=30000
AUDIO_PROBE_TIMEOUT_MS=8000
OPENAI_CHAT_TIMEOUT_MS=20000

# Max analyze audio duration in milliseconds (default: 60000 = 60s)
MAX_ANALYSIS_AUDIO_DURATION_MS=60000

# Azure Speech Pronunciation Assessment (server-side only)
# When AZURE_SPEECH_KEY and AZURE_SPEECH_REGION are set, pronunciation assessment is enabled automatically.
# Set ENABLE_PRONUNCIATION_ASSESSMENT=false to force text_match_only mode.
#
# Render production recommendation:
#   NODE_ENV=production
#   AZURE_PRONUNCIATION_TRANSPORT=rest
#   AZURE_PRONUNCIATION_ALLOW_SDK_FALLBACK=false
#   ENABLE_ANALYSIS_DEBUG=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_PRONUNCIATION_TRANSPORT=rest
AZURE_PRONUNCIATION_ALLOW_SDK_FALLBACK=false
ENABLE_ANALYSIS_DEBUG=false

# Roleplay authority and bounded-cost controls.
# Production must use Supabase so active-session leases and completion survive restarts.
ROLEPLAY_SESSION_STORE=supabase
ROLEPLAY_MAX_USER_TURNS=12
ROLEPLAY_MAX_USER_TEXT_LENGTH=500
ROLEPLAY_MAX_AI_REPLY_LENGTH=400
ROLEPLAY_CONTEXT_TURN_LIMIT=8
ROLEPLAY_SESSION_TTL_MS=2700000
ROLEPLAY_GENERATION_LEASE_MS=90000
ROLEPLAY_COACHING_LEASE_MS=90000
ROLEPLAY_MAX_OUTPUT_TOKENS=180
ROLEPLAY_COACHING_MAX_OUTPUT_TOKENS=700
ROLEPLAY_RATE_LIMIT_PER_MINUTE=20
ROLEPLAY_GUEST_RATE_LIMIT_PER_MINUTE=8
ROLEPLAY_IP_RATE_LIMIT_PER_MINUTE=40

# Mobile production env (set in project root .env after deploy — not in this file):
# EXPO_PUBLIC_ANALYSIS_ENDPOINT=https://YOUR_BACKEND_DOMAIN/api/analyze-speech
# EXPO_PUBLIC_AUDIO_REGISTRY_ENDPOINT=https://YOUR_BACKEND_DOMAIN/api/audio/registry
# Account deletion uses the same backend base URL: POST /api/account/delete
# (requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY on the server).
