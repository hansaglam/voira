# Copy this file to backend/.env and set your server-side keys:
#   cp backend/.env.example backend/.env
#
# Server-side only — never use EXPO_PUBLIC_ for secrets below.

PORT=3001
NODE_ENV=development

OPENAI_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=lesson-audio

ADMIN_SECRET=

# Comma-separated browser origins for admin panel CORS (mobile/native clients may omit Origin)
ALLOWED_ORIGINS=

# Public HTTPS URL of this backend in production (e.g. https://echospeak-api.onrender.com)
BACKEND_PUBLIC_URL=

# Max analyze requests per IP per minute (default: 10)
ANALYZE_RATE_LIMIT_PER_MINUTE=10

# Max analyze audio duration in milliseconds (default: 60000 = 60s)
MAX_ANALYSIS_AUDIO_DURATION_MS=60000

# Azure Speech Pronunciation Assessment (server-side only)
# When AZURE_SPEECH_KEY and AZURE_SPEECH_REGION are set, pronunciation assessment is enabled automatically.
# Set ENABLE_PRONUNCIATION_ASSESSMENT=false to force text_match_only mode.
#
# Render production recommendation:
#   NODE_ENV=production
#   AZURE_PRONUNCIATION_TRANSPORT=rest
#   AZURE_PRONUNCIATION_ALLOW_SDK_FALLBACK=false
#   ENABLE_ANALYSIS_DEBUG=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_PRONUNCIATION_TRANSPORT=rest
AZURE_PRONUNCIATION_ALLOW_SDK_FALLBACK=false
ENABLE_ANALYSIS_DEBUG=false

# Mobile production env (set in project root .env after deploy — not in this file):
# EXPO_PUBLIC_ANALYSIS_ENDPOINT=https://YOUR_BACKEND_DOMAIN/api/analyze-speech
# EXPO_PUBLIC_AUDIO_REGISTRY_ENDPOINT=https://YOUR_BACKEND_DOMAIN/api/audio/registry
